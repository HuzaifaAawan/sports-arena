# Copy this file to .env.local and fill in real values for local dev.
# The SAME variables must also be added in Vercel:
# Project -> Settings -> Environment Variables (Production + Preview).

# --- Google OAuth (used by NextAuth / Auth.js for "Sign in with Google") ---
# Google Cloud Console > APIs & Services > Credentials > your OAuth Client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Random secret NextAuth uses to sign session tokens. Generate with:
#   npx auth secret
AUTH_SECRET=

# --- Firebase Admin (server-only; used to read/write user roles in Firestore) ---
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
# That downloads a JSON file. Paste its ENTIRE content here as ONE line
# (no line breaks, no extra quotes around it — just the raw { ... } object).
# Example shape: {"type":"service_account","project_id":"...","private_key":"-----BEGIN...","client_email":"...", ...}
FIREBASE_SERVICE_ACCOUNT_JSON=
